<Page
    x:Class="HorizonBudget.Views.ManageAccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:HorizonBudget.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    >

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">

        <!-- TeachingTip -->
        <TeachingTip
            IsOpen="{Binding ShowTeachingTip, Mode=TwoWay}"
            Title="Attention Required"
            Subtitle="{Binding TeachingTipMessage}"
            
            IsLightDismissEnabled="True" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16">

                <!-- Account Name -->
                <StackPanel>
                    <TextBlock Text="Account Name" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Account.Name, Mode=TwoWay}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                        Background="{Binding NameError, Converter={StaticResource ErrorToBrushConverter}}"
                        PlaceholderText="e.g., Main Operating Chequing" />
                    <TextBlock Text="{Binding NameError}" Foreground="DarkGoldenrod" />
                </StackPanel>

                <!-- Ledger Selection -->
                <StackPanel>
                    <TextBlock Text="Ledger Entry" FontWeight="SemiBold" />
                    <AutoSuggestBox
                        ItemsSource="{Binding LedgerSuggestions}"
                        Text="{Binding SelectedLedgerCode, Mode=TwoWay}"
                        IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}"
                        PlaceholderText="Select Ledger Entry" />
                    <TextBlock Text="{Binding LedgerError}" Foreground="DarkGoldenrod" />
                </StackPanel>

                <!-- Opening Balance -->
                <StackPanel>
                    <TextBlock Text="Opening Balance" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Account.OpeningBalance, Mode=TwoWay}"
                        IsEnabled="{Binding IsNew}"
                        Background="{Binding OpeningBalanceError, Converter={StaticResource ErrorToBrushConverter}}"
                        PlaceholderText="0.00" />
                    <TextBlock Text="{Binding OpeningBalanceError}" Foreground="DarkGoldenrod" />
                </StackPanel>

                <!-- Current Balance -->
                <StackPanel>
                    <TextBlock Text="Current Balance" FontWeight="SemiBold" />
                    <TextBox
                        Text="{Binding Account.CurrentBalance}"
                        IsReadOnly="True" />
                </StackPanel>

                <!-- Status -->
                <StackPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" />
                    <ComboBox
                        ItemsSource="{Binding Status}"
                        SelectedItem="{Binding Account.Status, Mode=TwoWay}"
                        IsEnabled="{Binding IsEditing}" />
                </StackPanel>

                <!-- Created / Modified / Closed -->
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel>
                        <TextBlock Text="Created On" />
                        <TextBlock Text="{Binding Account.CreatedOn}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Modified On" />
                        <TextBlock Text="{Binding Account.ModifiedOn}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Closed On" />
                        <TextBlock
                            Text="{Binding Account.ClosedOn}"
                            Visibility="{Binding Account.Status, Converter={StaticResource ClosedStatusToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">

            <!-- Save New -->
            <Button
                Content="Save"
                Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding SaveNewCommand}" />

            <!-- Save Edit -->
            <Button
                Content="Save Changes"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                Command="{Binding SaveEditCommand}" />

            <!-- Begin Edit -->
            <Button
                Content="Edit"
                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Command="{Binding BeginEditCommand}" />

            <!-- Close Account -->
            <Button
                Content="Close Account"
                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Command="{Binding BeginCloseCommand}" />

            <!-- Delete -->
            <Button
                Content="Delete"
                Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                Command="{Binding DeleteCommand}" />

            <!-- Cancel -->
            <Button
                Content="Cancel"
                Command="{Binding CancelCommand}" />

        </StackPanel>

    </Grid>
</Page>
