<Page
    x:Class="HorizonBudget.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HorizonBudget.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:ViewModel="using:HorizonBudget.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <SolidColorBrush x:Key="BalanceBrush" Color="#FFF4CE"/>
    </Page.Resources>

    <StackPanel Padding="20" Orientation="Vertical" Spacing="16">

        <!-- Add Account Button -->
        <Button Content="Add Account"
                Command="{Binding AddAccountCommand}"
                HorizontalAlignment="Center"/>

        <!-- Accounts List -->
        <ListView ItemsSource="{Binding Accounts}"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  >

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="ViewModel:AccountItemViewModel">

                    <RelativePanel Padding="12">

                        <!-- Account Name -->
                        <StackPanel x:Name="NamePanel"
                                    Orientation="Vertical"
                                    RelativePanel.AlignLeftWithPanel="True"
                                    RelativePanel.AlignVerticalCenterWithPanel="True">

                            <TextBlock Text="{Binding LocalizedName}"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Text="{Binding AccountNumberSuffix}"
                                       FontSize="14"
                                       Foreground="Gray"/>

                            <Border Background="{StaticResource BalanceBrush}"
                                    Padding="4"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding CurrentBalance}"
                                           FontSize="14"
                                           Foreground="Black"/>
                            </Border>
                        </StackPanel>

                        <!-- Manage Button -->
                        <Button Content="Manage"
                                RelativePanel.AlignRightWithPanel="True"
                                RelativePanel.AlignVerticalCenterWithPanel="True"
                                RelativePanel.RightOf="NamePanel"
                                Command="{Binding DataContext.ManageAccountCommand,
                                          ElementName=AccountsList}"
                                          CommandParameter="{Binding Account}" />

                    </RelativePanel>

                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <!-- TeachingTip -->
        <TeachingTip x:Name="EmptyAccountsTip"
                     Title="No Accounts Found"
                     Subtitle="Add an account to get started."
                     IsOpen="False">
            <TeachingTip.IconSource>
                <FontIconSource Glyph="&#xE946;"/>
            </TeachingTip.IconSource>
        </TeachingTip>

    </StackPanel>
</Page>
