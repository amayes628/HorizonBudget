<Page
    x:Class="HorizonBudget.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HorizonBudget.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid ColumnDefinitions="260,*">

        <!-- LEFT NAVIGATION VIEW -->
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">

            <!-- TOP MENU ITEMS -->
            <NavigationView.MenuItems>

                <!-- HOME -->
                <NavigationViewItem Content="Home"
                                    Tag="home"
                                    Icon="Home"/>

                <!-- DASHBOARD -->
                <NavigationViewItem Content="Dashboard"
                                    Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Images/Icons/dashboard_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- ACCOUNTS -->
                <NavigationViewItem Content="Accounts"
                                    Tag="accounts">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Images/Icons/account_tree_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- EXPENSES -->
                <NavigationViewItem Content="Expenses"
                                    Tag="expenses">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Images/Icons/payments_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- INCOME -->
                <NavigationViewItem Content="Income"
                                    Tag="income">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Images/Icons/money_bag_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!-- BOTTOM MENU ITEMS -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/Icons/info_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Help"
                                    Tag="help">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="/Assets/Icons/home_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Images/Icons/settings_24.svg"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

        </NavigationView>

        <!-- RIGHT CONTENT FRAME -->
        <Frame x:Name="ContentFrame"
               Grid.Column="1"/>
    </Grid>
</Page>
